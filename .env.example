# Copy this file to .env for LOCAL testing only (do not commit .env)
# On Render, set this as an Environment Variable instead — see README.md
GEMINI_API_KEY=your_gemini_api_key_here

# Database (Render Postgres "Internal Database URL"). Leave empty locally to use SQLite.
DATABASE_URL=
# Optional: secret to view all users history at /api/admin/history?key=...
ADMIN_KEY=
